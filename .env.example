# Local development only. Never put production credentials in this file.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
LIVESCHOOL_WEB_ORIGIN=http://127.0.0.1:3000
LIVESCHOOL_OWNER_EMAIL=

# Automated tests must set LIVESCHOOL_ENV=test and use the local URL above.
# A local service-role key also requires LIVESCHOOL_TEST_ALLOW_SERVICE_ROLE=1.
# LIVESCHOOL_ENV=test
# LIVESCHOOL_TEST_ALLOW_SERVICE_ROLE=1

# Optional production integrations are intentionally left unset.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
